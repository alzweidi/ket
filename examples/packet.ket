  CNOT a, c
  Rz(0.1542125687670212) a
  Rz(0.1542125687670212) d
  CNOT a, d
  Rz(-0.1542125687670212) d
  CNOT a, d
  Rz(0.07710628438351061) a
  Rz(0.07710628438351061) e
  CNOT a, e
  Rz(-0.07710628438351061) e
  CNOT a, e
  Rz(0.0385531421917553) a
  Rz(0.0385531421917553) f
  CNOT a, f
  Rz(-0.0385531421917553) f
  CNOT a, f
  Rz(0.01927657109587765) a
  Rz(0.01927657109587765) g
  CNOT a, g
  Rz(-0.01927657109587765) g
  CNOT a, g
  Rz(-0.1542125687670212) b
  Rz(-0.1542125687670212) c
  CNOT b, c
  Rz(0.1542125687670212) c
  CNOT b, c
  Rz(-0.07710628438351061) b
  Rz(-0.07710628438351061) d
  CNOT b, d
  Rz(0.07710628438351061) d
  CNOT b, d
  Rz(-0.0385531421917553) b
  Rz(-0.0385531421917553) e
  CNOT b, e
  Rz(0.0385531421917553) e
  CNOT b, e
  Rz(-0.01927657109587765) b
  Rz(-0.01927657109587765) f
  CNOT b, f
  Rz(0.01927657109587765) f
  CNOT b, f
  Rz(-0.009638285547938826) b
  Rz(-0.009638285547938826) g
  CNOT b, g
  Rz(0.009638285547938826) g
  CNOT b, g
  Rz(-0.0385531421917553) c
  Rz(-0.0385531421917553) d
  CNOT c, d
  Rz(0.0385531421917553) d
  CNOT c, d
  Rz(-0.01927657109587765) c
  Rz(-0.01927657109587765) e
  CNOT c, e
  Rz(0.01927657109587765) e
  CNOT c, e
  Rz(-0.009638285547938826) c
  Rz(-0.009638285547938826) f
  CNOT c, f
  Rz(0.009638285547938826) f
  CNOT c, f
  Rz(-0.004819142773969413) c
  Rz(-0.004819142773969413) g
  CNOT c, g
  Rz(0.004819142773969413) g
  CNOT c, g
  Rz(-0.009638285547938826) d
  Rz(-0.009638285547938826) e
  CNOT d, e
  Rz(0.009638285547938826) e
  CNOT d, e
  Rz(-0.004819142773969413) d
  Rz(-0.004819142773969413) f
  CNOT d, f
  Rz(0.004819142773969413) f
  CNOT d, f
  Rz(-0.002409571386984707) d
  Rz(-0.002409571386984707) g
  CNOT d, g
  Rz(0.002409571386984707) g
  CNOT d, g
  Rz(-0.002409571386984707) e
  Rz(-0.002409571386984707) f
  CNOT e, f
  Rz(0.002409571386984707) f
  CNOT e, f
  Rz(-0.001204785693492353) e
