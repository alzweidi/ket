// a potential of 0.7 on sites 64 to 67 gives a phase of -0.175 per time step.
gate barrier(a, b, c, d, e) {
  X b
  X c
  X d
  X e
  Rz(-0.0109375) a
  Rz(-0.0109375) b
  CNOT a, b
  Rz(0.0109375) b
  CNOT a, b
  Rz(-0.0109375) c
  CNOT a, c
  Rz(0.0109375) c
  CNOT a, c
  CNOT b, c
  Rz(0.0109375) c
  CNOT b, c
  CNOT a, c
  CNOT b, c
  Rz(-0.0109375) c
  CNOT b, c
  CNOT a, c
  Rz(-0.0109375) d
  CNOT a, d
  Rz(0.0109375) d
  CNOT a, d
  CNOT b, d
  Rz(0.0109375) d
  CNOT b, d
  CNOT a, d
  CNOT b, d
  Rz(-0.0109375) d
  CNOT b, d
  CNOT a, d
  CNOT c, d
  Rz(0.0109375) d
  CNOT c, d
  CNOT a, d
  CNOT c, d
  Rz(-0.0109375) d
  CNOT c, d
  CNOT a, d
  CNOT b, d
  CNOT c, d
  Rz(-0.0109375) d
  CNOT c, d
  CNOT b, d
  CNOT a, d
  CNOT b, d
  CNOT c, d
  Rz(0.0109375) d
  CNOT c, d
  CNOT b, d
  CNOT a, d
  Rz(-0.0109375) e
  CNOT a, e
  Rz(0.0109375) e
  CNOT a, e
  CNOT b, e
  Rz(0.0109375) e
  CNOT b, e
  CNOT a, e
  CNOT b, e
  Rz(-0.0109375) e
  CNOT b, e
  CNOT a, e
  CNOT c, e
  Rz(0.0109375) e
  CNOT c, e
  CNOT a, e
  CNOT c, e
  Rz(-0.0109375) e
  CNOT c, e
  CNOT a, e
  CNOT b, e
  CNOT c, e
  Rz(-0.0109375) e
  CNOT c, e
  CNOT b, e
  CNOT a, e
  CNOT b, e
  CNOT c, e
  Rz(0.0109375) e
  CNOT c, e
  CNOT b, e
  CNOT a, e
  CNOT d, e
  Rz(0.0109375) e
  CNOT d, e
  CNOT a, e
  CNOT d, e
  Rz(-0.0109375) e
  CNOT d, e
  CNOT a, e
  CNOT b, e
  CNOT d, e
  Rz(-0.0109375) e
  CNOT d, e
  CNOT b, e
  CNOT a, e
  CNOT b, e
  CNOT d, e
  Rz(0.0109375) e
  CNOT d, e
  CNOT b, e
  CNOT a, e
  CNOT c, e
  CNOT d, e
  Rz(-0.0109375) e
  CNOT d, e
  CNOT c, e
  CNOT a, e
  CNOT c, e
  CNOT d, e
  Rz(0.0109375) e
  CNOT d, e
  CNOT c, e
  CNOT a, e
  CNOT b, e
  CNOT c, e
  CNOT d, e
  Rz(0.0109375) e
  CNOT d, e
  CNOT c, e
  CNOT b, e
  CNOT a, e
  CNOT b, e
  CNOT c, e
  CNOT d, e
  Rz(-0.0109375) e
  CNOT d, e
  CNOT c, e
  CNOT b, e
  CNOT a, e
  X b
  X c
  X d
  X e
}

// transform to momentum and apply the free-particle phase.
gate free_step(a, b, c, d, e, f, g) {
  to_momentum a, b, c, d, e, f, g
  kinetic a, b, c, d, e, f, g
}
